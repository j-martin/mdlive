{
  "name": "mdlive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mdlive": "./index.ts"
  },
  "scripts": {
    "start": "bun ./index.ts",
    "test": "bun test",
    "build": "bun build ./index.ts ./src/worker.ts --compile --minify --outfile dist/mdlive",
    "install-bin": "bun run build && sh -c 'dir=\"${INSTALL_DIR:-$HOME/.local/bin}\" && mkdir -p \"$dir\" && install -m 755 dist/mdlive \"$dir/mdlive\" && echo \"Installed $dir/mdlive\"'"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "marked": "^18.2.1",
    "webview-bun": "2.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
